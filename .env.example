# Who the container runs as: the owner of the data and secrets folders (id -u and id -g).
CHITRAGUPTA_UID=1000
CHITRAGUPTA_GID=1000

CHITRAGUPTA_PORT=8080
CHITRAGUPTA_TIMEZONE=America/New_York

# Folders on the host. Keep both outside any git checkout.
#   data:    tracker.db and backups/
#   secrets: simplefin-access-url, and when they are used: google-oauth-client.json, udaan-token, smtp-password
CHITRAGUPTA_DATA=./data
CHITRAGUPTA_SECRETS=./secrets

# Who reminders and alerts are written to. With Gmail and neither set, they go to the Gmail account itself.
REMINDER_TO_1=
REMINDER_TO_2=

# Reminders through Gmail need no setting here: put a Google OAuth client in the secrets folder as
# google-oauth-client.json, then use "Set up email alerts" under Manage. The README has the steps.
# Or by SMTP: set the host and put the password in the secrets folder as smtp-password.
# With neither, reminders are written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=

# Miles and points checked automatically: where "udaan serve" answers on the machine that runs Docker,
# with its token in the secrets folder as udaan-token (udaan token --copy-to <secrets>/udaan-token).
# Left empty, nothing is asked, and results can still be pushed to /api/balances/udaan.
UDAAN_URL=
# UDAAN_URL=http://host.docker.internal:8791
BALANCE_CHECK_AT=12:30
