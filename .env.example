# Who the container runs as: the owner of the data and secrets folders (id -u and id -g).
TRACKER_UID=1000
TRACKER_GID=1000

TRACKER_PORT=8080
TRACKER_TIMEZONE=America/New_York

# Folders on the host. Keep both outside any git checkout.
#   data:    tracker.db and backups/
#   secrets: simplefin-access-url, and smtp-password if reminders go by email
TRACKER_DATA=./data
TRACKER_SECRETS=./secrets

# Reminders by email. Leave SMTP_HOST empty to write reminders to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
REMINDER_TO_1=
REMINDER_TO_2=
