@inject TrackerClient Api

<div class="period">
    <div class="row">
        <div>
            <div class="name">@Period.BenefitName</div>
            @if (ShowCard)
            {
                <div class="muted">@Period.CardName · @Period.PersonName</div>
            }
        </div>
        <div class="amount">
            @if (Period.Status == "Used")
            {
                <span class="chip done">used</span>
            }
            else if (Period.HasDollarValue)
            {
                <span>@Format.Money(Period.Remaining) left</span>
            }
            else
            {
                <span class="muted">not used</span>
            }
        </div>
    </div>

    @if (Period.HasDollarValue)
    {
        <div class="bar"><span style="width:@Percent%"></span></div>
    }

    <div class="row">
        <div class="muted">
            @if (Period.HasDollarValue)
            {
                <span>@Format.Money(Period.Used) of @Format.Money(Period.Amount) · </span>
            }
            <span>to @Format.Day(Period.End)</span>
            @if (Period.Manual)
            {
                <span> · marked by hand</span>
            }
        </div>
        @if (Period.Status != "Used")
        {
            <span class="chip @(Period.DaysLeft <= 2 ? "now" : Period.DaysLeft <= 7 ? "soon" : "")">@Format.DaysLeft(Period.DaysLeft)</span>
        }
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <div class="actions">
        @if (Period.Status != "Used")
        {
            <button class="primary" disabled="@_busy" @onclick="() => UseAsync(null)">Mark used</button>
            @if (Period.HasDollarValue)
            {
                <input type="number" min="0" step="0.01" placeholder="Part" @bind="_part" @bind:event="oninput" aria-label="Part used, in dollars" />
                <button disabled="@(_busy || _part is null or <= 0)" @onclick="() => UseAsync(_part)">Add part</button>
            }
        }
        @if (Period.HasManualUsage)
        {
            <button class="quiet" disabled="@_busy" @onclick="UndoAsync">Undo what I marked</button>
        }
    </div>
    @if (!string.IsNullOrEmpty(Period.Notes) && ShowNotes)
    {
        <div class="muted">@Period.Notes</div>
    }
</div>

@code {
    private bool _busy;
    private string? _error;
    private decimal? _part;

    [Parameter, EditorRequired] public PeriodDto Period { get; set; } = null!;

    [Parameter] public bool ShowCard { get; set; }

    [Parameter] public bool ShowNotes { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private int Percent => Period.Amount <= 0 ? 0 : (int)Math.Round(Period.Used / Period.Amount * 100m);

    private Task UseAsync(decimal? amount) => RunAsync(() => Api.PostAsync($"api/periods/{Period.Id}/use", new UsePeriodRequest(amount, null)));

    private Task UndoAsync() => RunAsync(() => Api.DeleteAsync($"api/periods/{Period.Id}/manual-usage"));

    private async Task RunAsync(Func<Task> change)
    {
        _busy = true;
        _error = null;
        try
        {
            await change();
            _part = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception failure) when (failure is ApiException or HttpRequestException)
        {
            _error = Format.Failure(failure);
        }
        finally
        {
            _busy = false;
        }
    }
}
