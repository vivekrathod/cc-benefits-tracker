@* A catalog of a few hundred products: type to narrow, then pick. *@
<div class="fields">
    <div>
        <label>Find a card product</label>
        <input placeholder="e.g. sapphire, or citi executive" @bind="_filter" @bind:event="oninput" />
    </div>
    <div>
        <label>Product</label>
        <select value="@Value" @onchange="OnPicked">
            <option value="">Choose…</option>
            @foreach (var product in Matches)
            {
                <option value="@product.Id">@product.DisplayName @(product.IsBusiness ? "(business)" : "")</option>
            }
        </select>
    </div>
</div>
@if (_filter.Trim().Length > 0 && !ProductSearch.Find(Products, _filter).Any())
{
    <div class="muted">No product matches that. Try fewer words, or pick "Other card (not in the catalog)" for a card that is not listed.</div>
}

@code {
    private string _filter = "";

    [Parameter, EditorRequired] public IReadOnlyList<ProductDto> Products { get; set; } = [];

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private IEnumerable<ProductDto> Matches
    {
        get
        {
            // The picked product stays in the list while the filter text changes.
            var found = ProductSearch.Find(Products, _filter);
            var picked = Products.FirstOrDefault(product => product.Id == Value);
            return picked is null || found.Contains(picked) ? found : found.Prepend(picked);
        }
    }

    private Task OnPicked(ChangeEventArgs change)
    {
        var picked = change.Value as string;
        return ValueChanged.InvokeAsync(string.IsNullOrEmpty(picked) ? null : picked);
    }
}
