@page "/points"
@implements IDisposable
@inject TrackerClient Api

<PageTitle>Miles and points</PageTitle>
<h1>Miles and points</h1>

<Loader Ready="@(_view is not null)" Error="@_error">
    @if (_view!.Checker?.UnreachableSince is { } down)
    {
        <p class="error">
            <strong>The balance automation is not answering</strong>, since @Format.Time(down). Nothing can be checked until it does.
            @_view.Checker.Problem
        </p>
    }
    else if (_view.Checker?.Problem is { } problem)
    {
        <p class="error">The last check did not complete: @problem It is asked again in a while.</p>
    }

    @foreach (var check in _view.Checks.Where(check => check.Status != "Ok" || check.Overdue))
    {
        <p class="error">
            <strong>@check.Account</strong> (@check.Program):
            @if (check.Status == "Ok")
            {
                <text>nothing heard since @Format.Time(check.CheckedAt).</text>
            }
            else
            {
                <text>@Format.CheckStatus(check.Status) since @Format.Time(check.FailingSince ?? check.CheckedAt). @check.Problem</text>
            }
            @if (check.Advice is not null)
            {
                <br />
                @check.Advice
            }
        </p>
    }

    @if (_view.Balances.Count == 0)
    {
        <p class="empty">No balances yet. They arrive by themselves once an automatic check is set up, or can be typed in below.</p>
    }

    @foreach (var person in _view.Balances.GroupBy(balance => (balance.PersonId, balance.PersonName)))
    {
        <h2>@person.Key.PersonName</h2>
        <div class="card">
            @foreach (var balance in person)
            {
                <BalanceRow @key="(balance.PersonId, balance.Program)" Balance="balance" Busy="_busy" OnRemove="RemoveAsync" />
            }
        </div>
    }

    <h2>Set a balance by hand</h2>
    <div class="card">
        <p class="muted">For a program nothing checks automatically. Saving under a name that is already listed replaces its number.</p>
        <div class="fields">
            <div>
                <label>Whose?</label>
                <select @bind="_personId">
                    <option value="">Choose…</option>
                    @foreach (var person in _people!)
                    {
                        <option value="@person.Id">@person.Name</option>
                    }
                </select>
            </div>
            <div>
                <label>Program</label>
                <input @bind="_program" @bind:event="oninput" list="programs" placeholder="Chase Ultimate Rewards" />
                <datalist id="programs">
                    @foreach (var program in _programs!)
                    {
                        <option value="@program"></option>
                    }
                </datalist>
            </div>
            <div><label>Balance</label><input type="number" min="0" step="1" style="width:8rem" @bind="_amount" @bind:event="oninput" /></div>
            <div><label>Expire on (optional)</label><input type="date" @bind="_expiresOn" /></div>
        </div>
        <div class="actions">
            <button class="primary" disabled="@(_busy || string.IsNullOrEmpty(_personId) || string.IsNullOrWhiteSpace(_program) || _amount is null or < 0)" @onclick="SaveAsync">Save</button>
        </div>
    </div>

    @if (_view.Checks.Count > 0)
    {
        <h2>Automatic checks</h2>
        <div class="card">
            <table>
                <tbody>
                    @foreach (var check in _view.Checks)
                    {
                        <tr @key="check.Account">
                            <td>
                                @check.Account
                                <div class="muted">@check.Program · last tried @Format.Time(check.CheckedAt)</div>
                                <div class="marks" aria-label="Recent attempts, oldest first">
                                    @foreach (var attempt in check.Recent)
                                    {
                                        <span class="mark @Mark(attempt)" title="@Format.Time(attempt.CheckedAt): @Format.Attempt(attempt)"></span>
                                    }
                                </div>
                            </td>
                            <td class="num">
                                <span class="chip @(check.Status != "Ok" ? "now" : check.Overdue ? "soon" : "done")">
                                    @(check.Status == "Ok" && check.Overdue ? "not checked" : Format.CheckStatus(check.Status))
                                </span>
                                <div class="actions end">
                                    @if (check.Queued)
                                    {
                                        <span class="muted">@(_view.Checker?.Running == check.Account ? "checking…" : "waiting its turn…")</span>
                                    }
                                    else if (check.CanCheckNow)
                                    {
                                        <button class="quiet" disabled="@_busy" @onclick="() => CheckNowAsync(check)">Check now</button>
                                    }
                                    @if (check.Overdue)
                                    {
                                        <button class="quiet" disabled="@_busy" title="For an account the automation no longer has. Its balance stays." @onclick="() => ForgetAsync(check)">Forget</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_view.Checker is { } checker)
            {
                <p class="muted">
                    Each account is checked once a day from @Format.TimeOfDay(checker.DailyAt), one at a time. A sign-in is tried at most
                    @checker.SignInsPerDay times a day for an account, "Check now" included, to stay clear of lockouts.
                </p>
            }
        </div>
    }
</Loader>

@code {
    private BalancesDto? _view;
    private IReadOnlyList<PersonDto>? _people;
    private IReadOnlyList<string>? _programs;
    private string? _error;
    private bool _busy;
    private string _personId = "";
    private string _program = "";
    private long? _amount;
    private DateOnly? _expiresOn;
    private readonly CancellationTokenSource _leaving = new();
    private bool _watching;

    protected override Task OnInitializedAsync() => LoadAsync();

    public void Dispose()
    {
        _leaving.Cancel();
        _leaving.Dispose();
    }

    private static string Mark(BalanceAttemptDto attempt) => attempt.Status == "Ok" ? "ok" : attempt.SignedIn ? "bad" : "skip";

    private async Task LoadAsync()
    {
        try
        {
            _people ??= await Api.GetAsync<IReadOnlyList<PersonDto>>("api/people");
            _programs ??= (await Api.GetAsync<IReadOnlyList<ProductDto>>("api/catalog/products"))
                .Select(product => product.PointsProgram)
                .OfType<string>()
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Order(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            _view = await Api.GetAsync<BalancesDto>("api/balances");
            _error = null;
            _ = WatchAsync();
        }
        catch (Exception failure) when (failure is ApiException or HttpRequestException)
        {
            _error = Format.Failure(failure);
        }
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        await Api.PostAsync("api/balances", new RecordBalanceRequest(Guid.Parse(_personId), _program, _amount!.Value, _expiresOn));
        (_program, _amount, _expiresOn) = ("", null, null);
    });

    private Task CheckNowAsync(BalanceCheckDto check) =>
        RunAsync(() => Api.PostAsync($"api/balances/checks/{Uri.EscapeDataString(check.Account)}"));

    private Task ForgetAsync(BalanceCheckDto check) =>
        RunAsync(() => Api.DeleteAsync($"api/balances/checks/{Uri.EscapeDataString(check.Account)}"));

    /// <summary>While a check somebody asked for is waiting or running, the page looks again by itself.</summary>
    private async Task WatchAsync()
    {
        if (_watching)
        {
            return;
        }

        _watching = true;
        try
        {
            while (_view is not null && (_view.Checker?.Running is not null || _view.Checks.Any(check => check.Queued)))
            {
                await Task.Delay(TimeSpan.FromSeconds(5), _leaving.Token);
                _view = await Api.GetAsync<BalancesDto>("api/balances");
                StateHasChanged();
            }
        }
        catch (Exception stopped) when (stopped is OperationCanceledException or ObjectDisposedException or ApiException or HttpRequestException)
        {
            // Leaving the page, or a server that went away: the next visit loads it again.
        }
        finally
        {
            _watching = false;
        }
    }

    private Task RemoveAsync(BalanceDto balance) =>
        RunAsync(() => Api.DeleteAsync($"api/balances?personId={balance.PersonId}&program={Uri.EscapeDataString(balance.Program)}"));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception failure) when (failure is ApiException or HttpRequestException)
        {
            _error = Format.Failure(failure);
        }
        finally
        {
            _busy = false;
        }
    }
}
